# Copy to .env and fill in the keys you have. Leave the rest blank.
# Every provider below has a free tier. You do NOT need all of them —
# the router uses whatever is configured and falls back automatically.

# Groq (free tier, very fast) -> https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (free tier) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter (has free models) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cerebras (free tier) -> https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Ollama runs locally and needs no key. Just set the host if non-default.
OLLAMA_HOST=http://localhost:11434
